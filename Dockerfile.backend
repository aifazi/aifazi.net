# ── aifazi.net Backend — Root Dockerfile for Coolify ─────────────────────────
# This Dockerfile is at the repo root. It copies the backend directory and
# builds from there, so all relative paths in the backend Dockerfile work.
FROM python:3.12.9-slim

WORKDIR /build
COPY aifazi.net-backend-fastapi/ ./

WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libffi-dev libjpeg-dev zlib1g-dev \
    tesseract-ocr tesseract-ocr-eng \
    && rm -rf /var/lib/apt/lists/*

COPY aifazi.net-backend-fastapi/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && apt-get purge -y build-essential libffi-dev libjpeg-dev zlib1g-dev \
    && apt-get autoremove -y \
    && apt-get clean

RUN apt-get update && apt-get install -y --no-install-recommends \
    wireguard-tools iptables iproute2 gosu curl wget \
    libjpeg62-turbo zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Create the non-root user BEFORE copying app files so COPY --chown resolves.
RUN addgroup --system app && adduser --system --group app \
    && mkdir -p /app /data/wireguard \
    && chown -R app:app /app \
    && chown -R app:app /data/wireguard

COPY --chown=app:app aifazi.net-backend-fastapi/ ./

COPY aifazi.net-backend-fastapi/scripts/init-wireguard.sh /usr/local/bin/init-wireguard.sh
RUN chmod +x /usr/local/bin/init-wireguard.sh

ENV PORT=8000

EXPOSE 8000 51820/udp

COPY aifazi.net-backend-fastapi/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request, os; urllib.request.urlopen('http://localhost:' + os.environ.get('PORT', '8000') + '/api/monitor/ping')"]

# Drop privileges last — all COPY/chmod above must run as root.
USER app
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
