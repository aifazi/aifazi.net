# aifazi.net frontend — environment template.
# Copy to `.env.local` and fill in your values. Every NEXT_PUBLIC_* key
# referenced in code is listed below with a safe placeholder (no secrets).
# NEXT_PUBLIC_* vars are inlined into the browser bundle — never put secrets in them.

# ── Deployment URLs (lib/config.ts; all default to *.aifazi.net when unset) ──
NEXT_PUBLIC_SITE_URL=https://aifazi.net
NEXT_PUBLIC_API_URL=https://api.aifazi.net
NEXT_PUBLIC_CDN_URL=https://cdn.aifazi.net
NEXT_PUBLIC_STORE_URL=https://store.aifazi.net
NEXT_PUBLIC_FIVEM_URL=https://fivem.aifazi.net
NEXT_PUBLIC_STATUS_URL=https://status.aifazi.net
NEXT_PUBLIC_DISCORD_URL=https://discord.aifazi.net
NEXT_PUBLIC_ADMIN_URL=https://admin.aifazi.net
NEXT_PUBLIC_TXADMIN_URL=https://txadmin.aifazi.net

# FiveM game-server connect address shown on the status page (lib/config.ts)
NEXT_PUBLIC_FIVEM_CONNECT=play.aifazi.net

# Nextcloud Talk base URL for chat/call links (lib/talk.ts)
NEXT_PUBLIC_TALK_URL=https://cloud.aifazi.net/apps/spreed

# ── Integrations (client-safe) ──
# Supabase project URL + anon key (lib/supabase.ts)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Sentry DSN for browser error reporting (sentry.client.config.ts)
NEXT_PUBLIC_SENTRY_DSN=
# VAPID public key for Web Push (lib/webPush.js)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Cloudinary cloud name for cdnUrl() rewriting (lib/api.ts)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ── Server-only (never NEXT_PUBLIC_; set in hosting env, not the bundle) ──
# Shared secret stamped on /api/* requests by proxy.ts — must match backend.
INTERNAL_API_SECRET=
# Must match the backend's ADMIN_GATE_SECRET exactly (proxy.ts, admin page).
ADMIN_GATE_SECRET=
# NOTE: MAIL_WEBHOOK_SECRET must be set in prod — the mail-queue
# webhook/inbound + process-pending exemptions in proxy.ts are gated on it.
# When empty those routes fall back to the admin-session gate (fail-closed).
MAIL_WEBHOOK_SECRET=
# Server/edge Sentry DSN (sentry.server.config.ts, sentry.edge.config.ts).
SENTRY_DSN=
# Server-side Cloudinary cloud name (app/api/cdn/[...path]/route.ts).
CLOUDINARY_CLOUD_NAME=
# Optional direct backend origin for server fetches (lib/contentServer.ts).
INTERNAL_API_URL=
