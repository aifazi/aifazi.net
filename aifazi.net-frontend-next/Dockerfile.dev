# ──────────────────────────────────────────────────────────────
# Dockerfile.dev — Next.js Frontend (hot-reload dev server)
# ──────────────────────────────────────────────────────────────
FROM node:22-alpine

WORKDIR /app

# Install dependencies first (layer caching)
COPY package.json package-lock.json* ./
RUN npm install

# Copy source
COPY . .

EXPOSE 3000
CMD ["npm", "run", "dev", "--", "-p", "3000"]
