# Copy to .env.local and adjust values. Expo auto-loads .env.local
# (EXPO_PUBLIC_* are inlined into the bundle). All values are optional —
# defaults point at the production API.

# Base URL of the aifazi.net FastAPI backend (no trailing slash).
EXPO_PUBLIC_API_URL=https://api.aifazi.net

# Supabase project used ONLY for Realtime chat (messages, typing). Same
# project the web app uses — get the values from the Supabase dashboard
# (Project Settings > API) or copy from the web app's Vercel env:
#   NEXT_PUBLIC_SUPABASE_URL  ->  EXPO_PUBLIC_SUPABASE_URL
#   NEXT_PUBLIC_SUPABASE_ANON_KEY -> EXPO_PUBLIC_SUPABASE_ANON_KEY
# The anon key is publishable (RLS protects the data). Without these, the app
# falls back to 4s REST polling.
EXPO_PUBLIC_SUPABASE_URL=https://ztqjfhhuiniinkfsgvjlr.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=