# Copy to .env.local and adjust values. Expo auto-loads .env.local
# (EXPO_PUBLIC_* are inlined into the bundle). All values are optional —
# defaults point at the production API.

# Base URL of the aifazi.net FastAPI backend (no trailing slash).
# This is currently the ONLY EXPO_PUBLIC_* key the app code reads
# (src/lib/getApiBase.ts; release/update URLs derive from it in src/lib/updates.ts).
EXPO_PUBLIC_API_URL=https://api.aifazi.net
# NOTE: EXPO_PUBLIC_RELEASE_URL is NOT read by the app (named only in the
# superseded PLAN-REDESIGN-REVAMP.md gap table). Do not add it unless code
# starts reading it.