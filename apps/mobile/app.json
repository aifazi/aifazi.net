{
  "expo": {
    "name": "aifazi",
    "slug": "fazi",
    "version": "1.0.36",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aifazi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "net.aifazi.mobile",
      "buildNumber": "1.0.36",
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "aifazi uses the microphone for voice and video calls.",
        "NSCameraUsageDescription": "aifazi uses the camera for video calls and screen share.",
        "NSScreenCaptureUsageDescription": "aifazi shares your screen during calls.",
        "UIBackgroundModes": [
          "audio",
          "voip",
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "api.aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": true
            },
            "cdn.aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            },
            "aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            },
            "u.expo.dev": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "bitcode": false
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "RECORD_AUDIO",
        "CAMERA",
        "MODIFY_AUDIO_SETTINGS",
        "BLUETOOTH_CONNECT",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION",
        "FOREGROUND_SERVICE_MICROPHONE",
        "WAKE_LOCK",
        "REQUEST_INSTALL_PACKAGES",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#060a0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "net.aifazi.mobile",
      "versionCode": 1000036
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060a0f"
        }
      ],
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#00ff88",
          "mode": "production"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": true
          },
          "ios": {
            "enableMultitaskingCameraAccess": true
          }
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "aifazi accesses your photos so you can share images in chat.",
          "cameraPermission": "aifazi uses the camera so you can share photos in chat.",
          "microphonePermission": "aifazi uses the microphone for voice notes and voice/video calls."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-gradle-memory"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd9069e-469a-410f-90d3-942f4901470c"
      }
    },
    "owner": "aifazi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cd9069e-469a-410f-90d3-942f4901470c",
      "channel": "production",
      "checkAutomatically": "NEVER",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
