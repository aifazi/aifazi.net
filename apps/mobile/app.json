{
  "expo": {
    "name": "aifazi",
    "slug": "fazi",
    "version": "1.0.70",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aifazi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "net.aifazi.mobile",
      "buildNumber": "1.0.70",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "aifazi uses the camera so you can take photos to upload.",
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "api.aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true,
              "NSRequiresCertificateTransparency": true
            },
            "cdn.aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            },
            "aifazi.net": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            },
            "u.expo.dev": {
              "NSExceptionRequiresForwardSecrecy": true,
              "NSExceptionMinimumTLSVersion": "TLSv1.2",
              "NSIncludesSubdomains": true
            }
          }
        }
      },
      "bitcode": false
    },
    "android": {
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#060a0f",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "package": "net.aifazi.mobile",
      "versionCode": 1000070
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#060a0f"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "color": "#00ff88",
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "aifazi accesses your photos so you can upload profile and document images.",
          "cameraPermission": "aifazi uses the camera so you can take photos to upload."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "./plugins/with-release-signing",
      "./plugins/with-gradle-memory",
      "./plugins/with-android-manifest"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cd9069e-469a-410f-90d3-942f4901470c"
      }
    },
    "owner": "aifazi",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4cd9069e-469a-410f-90d3-942f4901470c",
      "channel": "production",
      "checkAutomatically": "NEVER"
    }
  }
}
