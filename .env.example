# ══════════════════════════════════════════════════════════════
# Docker Dev Environment Variables
# Copy to .env and fill in real values
# ══════════════════════════════════════════════════════════════

# ── Shared Secrets (must match between frontend & backend) ──
PASETO_SECRET=dev-paseto-secret-change-me
INTERNAL_API_SECRET=dev-internal-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
ADMIN_GATE_SECRET=
CRON_SECRET=dev-cron-secret

# ── Admin ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (generate with the backend's reset_password.py).
# NEVER commit a real hash here — this example must stay a placeholder.
ADMIN_PASSWORD=$2b$12$CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# ADMIN_PASSWORD_HASH: preferred over ADMIN_PASSWORD when set
# (backend routers/auth_shared.py reads it first). Leadership-only — placeholder only.
#ADMIN_PASSWORD_HASH=$2b$12$CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# COOKIE_DOMAIN: REQUIRED in production (e.g. .aifazi.net) for cross-subdomain
# SSO cookies — backend fail-closes when ENV=production and unset.
#COOKIE_DOMAIN=.aifazi.net

# ── Supabase ───────────────────────────────────────────────────
# Get these from your Supabase dashboard: Project Settings > API
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email ──────────────────────────────────────────────────────
MAIL_WEBHOOK_SECRET=
# MAIL_FROM: sender address for backend transactional mail
# (default noreply@aifazi.net). Set to your verified domain.
#MAIL_FROM=noreply@example.com

# ── Site OAuth login (optional, one block per button) ──────────────
# Upstream IdP (Authentik). Portal values in Admin → Identity & OAuth
# override these — no redeploy needed.
#AUTHENTIK_ISSUER=https://auth.aifazi.net
#AUTHENTIK_CLIENT_ID=aifazi-net
#AUTHENTIK_CLIENT_SECRET=PASTE_FROM_AUTHENTIK
# AUTHENTIK_API_TOKEN: Leadership-only secret for the admin-API user
# disable/enable sync. Without it the toggle works local-only with a warning.
#AUTHENTIK_API_TOKEN=PASTE_FROM_AUTHENTIK_ADMIN_API
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_REDIRECT_URI=https://api.aifazi.net/api/auth/discord/callback
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=
#STEAM_API_KEY=

# ── Redis / Upstash (distributed rate limiting) ────────────────────
# Backend prefers REDIS_URL when set, else the Upstash REST pair.
# Required in production for per-IP sliding windows across instances.
#REDIS_URL=redis://localhost:6379/0
#UPSTASH_REDIS_REST_URL=
#UPSTASH_REDIS_REST_TOKEN=

# ── LLDAP directory (optional) ─────────────────────────────────────
# BIND_PASSWORD is Leadership-only — placeholder only, never a real value.
#LLDAP_URL=ldap://lldap:3890
#LLDAP_BASE_DN=dc=aifazi,dc=net
#LLDAP_USERS_OU=ou=people,dc=aifazi,dc=net
#LLDAP_BIND_DN=uid=admin,ou=people,dc=aifazi,dc=net
#LLDAP_BIND_PASSWORD=
#LLDAP_TIMEOUT=5

# ── Storage ────────────────────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=
CLOUDFLARE_R2_SECRET_KEY=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_BUCKET=
CLOUDINARY_URL=

# ── Monitoring ─────────────────────────────────────────────────
SENTRY_DSN=

# ── Deployment domains ─────────────────────────────────────────
# Defaults match the production aifazi.net deployment. Override to run the
# whole stack on your own domain(s). On a single-domain deploy, set
# STORE/FIVEM/STATUS/CDN to your own site URL — subdomain routing disables
# itself and everything is served from paths on the main domain.
SITE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CDN_URL=http://localhost:3000
NEXT_PUBLIC_STORE_URL=http://localhost:3000
NEXT_PUBLIC_FIVEM_URL=http://localhost:3000
NEXT_PUBLIC_STATUS_URL=http://localhost:3000
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/your-invite
NEXT_PUBLIC_FIVEM_CONNECT=127.0.0.1:30120
CDN_URL=http://localhost:3000

# ── ClamAV malware scanning (backend) ──────────────────────────
# Uploads are scanned only when MALWARE_SCAN_ENABLED=true. Fail-closed by default
# (H3): a failed antivirus scan rejects uploads (503) instead of allowing
# unscanned files through. Set MALWARE_SCAN_FAIL_CLOSED=false only to opt out.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=true
CLAMD_HOST=clamav
CLAMD_PORT=3310

# ── Stalwart mail server admin (backend) ─────────────────────────────
# STALWART_ADMIN_PASSWORD is REQUIRED for the Stalwart admin panel API —
# fail-closed 503 when unset. The rest have working defaults and are optional.
STALWART_URL=http://stalwart:8080
STALWART_JMAP_URL=
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=

# ── Webhooks & newsletter signing ────────────────────────────────────
# DEPLOY_WEBHOOK_SECRET: REQUIRED for the deploy webhook endpoint —
# fail-closed 503 when unset.
DEPLOY_WEBHOOK_SECRET=
# RESEND_WEBHOOK_SECRET: optional (Resend Svix signing secret, whsec_...).
# The Resend delivery webhook rejects all events until this is set.
RESEND_WEBHOOK_SECRET=
# NEWSLETTER_SECRET: REQUIRED for newsletter double opt-in — /subscribe and
# /confirm return 503 when unset (fail-closed so confirm tokens can never be
# forged with a dev default).
NEWSLETTER_SECRET=
