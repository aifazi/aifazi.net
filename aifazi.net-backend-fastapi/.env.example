PASETO_SECRET=generate-with-python-c-secrets-token_hex-32
# Legacy JWT_SECRET kept for backward compatibility during migration
JWT_SECRET=generate-with-python-c-secrets-token_hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$12$...  # bcrypt hash of your admin password (or plain text for dev)
FRONTEND_URL=https://aifazi.net   # Use http://localhost:3000 in development
SENTRY_DSN=https://...@sentry.io/...
ENV=production

# Cron endpoint protection (set any random secret, e.g. python -c "import secrets; print(secrets.token_hex(32))")
CRON_SECRET=your-random-cron-secret

# Internal API secret — blocks direct calls that bypass the Next.js frontend.
# Must be the same value set in the frontend INTERNAL_API_SECRET env var.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=your-random-internal-secret

# Admin gate secret — used by the frontend proxy to verify admin session tokens.
# Falls back to INTERNAL_API_SECRET, then JWT_SECRET if not set.
ADMIN_GATE_SECRET=your-admin-gate-secret
