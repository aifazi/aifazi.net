PASETO_SECRET=generate-with-python-c-secrets-token_hex-32
# Legacy JWT_SECRET kept for backward compatibility during migration
JWT_SECRET=generate-with-python-c-secrets-token_hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=$2b$12$...  # bcrypt hash of your admin password (or plain text for dev)
FRONTEND_URL=https://aifazi.net   # Use http://localhost:3000 in development
CDN_URL=https://cdn.aifazi.net    # Used in the admin CSP; override for a custom CDN domain
SENTRY_DSN=https://...@sentry.io/...
ENV=production

# Cron endpoint protection (set any random secret, e.g. python -c "import secrets; print(secrets.token_hex(32))")
CRON_SECRET=your-random-cron-secret

# Internal API secret — blocks direct calls that bypass the Next.js frontend.
# Must be the same value set in the frontend INTERNAL_API_SECRET env var.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_SECRET=your-random-internal-secret

# Admin gate secret — used by the frontend proxy to verify admin session tokens.
# Falls back to INTERNAL_API_SECRET, then JWT_SECRET if not set.
ADMIN_GATE_SECRET=your-admin-gate-secret

# FiveM connect token signing key — MUST be separate from INTERNAL_API_SECRET
# (which ships to the browser as X-Internal-Token; anyone with it could forge
# connect tokens). Server-side only. Falls back to PASETO_SECRET/JWT_SECRET.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FIVEM_CONNECT_SECRET=generate-with-python-c-secrets-token_hex-32

# GitHub personal access token with repo/Contents:Read on aifazi/aifazi.net.
# Used by the mobile release proxy (/api/mobile/release/*) to read the PRIVATE
# repo's latest release and stream the APK to the mobile app updater.
# Create: https://github.com/settings/tokens (classic 'repo' scope is enough).
GITHUB_TOKEN=your-github-pat

# ── ClamAV malware scanning (optional) ────────────────────────────────────────
# Uploads (/upload, /upload/multiple, /upload/chat) are scanned only when
# MALWARE_SCAN_ENABLED=true. CLAMD_HOST/CLAMD_PORT point at the clamd daemon
# (localhost:3310 for a native install, `clamav:3310` inside docker-compose).
# Fail-closed by default (H3): a failed/unreachable scan rejects the upload with
# 503 instead of silently allowing unscanned files through. Set
# MALWARE_SCAN_FAIL_CLOSED=false only to opt into fail-open behavior.
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=true
CLAMD_HOST=localhost
CLAMD_PORT=3310

# ── Mail delivery webhooks ───────────────────────────────────────────────────
# Generic Brevo-style endpoint (/api/admin/mail/queue/webhook/inbound): shared
# secret sent as X-Webhook-Key (or HMAC-SHA256 body as X-Webhook-Signature).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
MAIL_WEBHOOK_SECRET=
# Resend endpoint (/api/admin/mail/queue/webhook/resend): Svix signing secret
# (whsec_...) shown ONCE when creating the webhook in Resend dashboard.
RESEND_WEBHOOK_SECRET=

# ── WireGuard VPN (optional) ─────────────────────────────────────────────────
# Peer management talks to the host WireGuard API (WG_API_URL); peer tunnel
# IPs come from WG_SUBNET. Dual-stack is OFF by default — set WG_DUALSTACK=true
# only after the host has a working IPv6 uplink + NAT66 (see
# scripts/setup-wireguard-vps.sh) and supabase/migrations/*_vpn_dualstack.sql
# has been applied (adds vpn_peers.allocated_ipv6).
#WG_API_URL=http://10.0.1.1:51821
#WG_API_TOKEN=host-management-api-secret
#WG_SUBNET=10.8.0.0/24
#WG_SERVER_IP=10.8.0.1
#WG_ENDPOINT=75.119.131.157
#WG_DUALSTACK=false
#WG_SUBNET_V6=fd00:8::/64
#WG_SERVER_IPV6=fd00:8::1

# ── Cloudflare Radar URL Scanner (optional) ──────────────────────────────────
# User-submitted links (forum threads/replies, chat + DM messages, blog posts/
# comments, contact messages, chat link previews) are checked against Cloudflare
# URL Scanner verdicts for malicious/phishing content. Fully disabled (every
# check reports "unknown") until BOTH variables are set.
#   CLOUDFLARE_ACCOUNT_ID      — your Cloudflare account id (dashboard → right sidebar)
#   CLOUDFLARE_RADAR_API_TOKEN — API token with Account > URL Scanner > Edit permission
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_RADAR_API_TOKEN=

# ── Site OAuth login (optional, one block per button) ───────────────────────
# Upstream IdP (Authentik, "Continue with Authentik" button). Portal values
# in Admin → Identity & OAuth override these env vars — no redeploy needed.
#AUTHENTIK_ISSUER=https://auth.aifazi.net
#AUTHENTIK_CLIENT_ID=aifazi-net
#AUTHENTIK_CLIENT_SECRET=paste-from-authentik-provider
#AUTHENTIK_REDIRECT_URI=https://api.aifazi.net/api/auth/authentik/callback
# Discord ("Continue with Discord" button). Values from the Discord Developer
# Portal (application → OAuth2). The redirect MUST be registered there exactly
# or Discord rejects the login before any callback happens.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.aifazi.net/api/auth/discord/callback
#DISCORD_BOT_TOKEN=
#DISCORD_WHITELIST_GUILD_ID=
#DISCORD_WHITELIST_ROLE_ID=
# WireGuard one-click login (optional, VPN users only). The endpoint additionally
# requires the client IP in WG_SUBNET with a mapping in _WG_IP_MAP
# (routers/auth_sessions.py) — off unless explicitly enabled.
#WG_LOGIN_ENABLED=true
