# ════════════════════════════════════════════════════════
# aifazi.net — Local Development Environment (Docker/WSL)
# ════════════════════════════════════════════════════════
# PREFERRED: run `bash scripts/merge-env.sh` after pulling from Vercel
#   (vercel env pull) to get real production secrets automatically.
#
# This file is a fallback template. Do NOT commit real values.

# ── Required ─────────────────────────────────────────────
ENV=development
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://backend:8000
COOKIE_DOMAIN=
NEXT_TELEMETRY_DISABLED=1
COMPOSE_PROJECT_NAME=aifazi-local

# ── Must match values in Vercel (backend project) ────────
PASETO_SECRET=REPLACE_ME
INTERNAL_API_SECRET=REPLACE_ME
ADMIN_GATE_SECRET=REPLACE_ME
CRON_SECRET=REPLACE_ME
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME
# COOKIE_DOMAIN=REPLACE_ME  # Required in production (e.g., .aifazi.net)

# ── Supabase (production project used for local testing) ─
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME
NEXT_PUBLIC_SUPABASE_URL=https://YOURPROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_ME

# ── Optional integrations (copy from Vercel) ─────────────
DISCORD_CLIENT_ID=REPLACE_ME
DISCORD_CLIENT_SECRET=REPLACE_ME
GITHUB_CLIENT_ID=REPLACE_ME
GITHUB_CLIENT_SECRET=REPLACE_ME
STEAM_API_KEY=REPLACE_ME
STRIPE_SECRET_KEY=REPLACE_ME
STRIPE_WEBHOOK_SECRET=REPLACE_ME
SENTRY_DSN=REPLACE_ME
FIVEM_CONNECT_URL=REPLACE_ME
FIVEM_SERVER_SECRET=REPLACE_ME
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=REPLACE_ME
CLOUDINARY_CLOUD_NAME=REPLACE_ME
NEXT_PUBLIC_R2_PUBLIC_URL=REPLACE_ME
NEXT_PUBLIC_VAPID_PUBLIC_KEY=REPLACE_ME

# ── Upstash Redis (distributed rate limiting) ─────────────
# Required for production — creates per-IP sliding window across all instances
# Get from https://console.upstash.com/redis (free tier: 10k req/day)
UPSTASH_REDIS_REST_URL=REPLACE_ME
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# ── Monitoring (uptime checker) ──────────────────────────
# Alert emails + threshold are managed in the admin Monitoring → Settings tab
# (stored in site_config). These env vars are optional overrides only.
MONITOR_ALERT_EMAILS=
MONITOR_ALERT_THRESHOLD=2
BACKEND_URL=https://api.aifazi.net
