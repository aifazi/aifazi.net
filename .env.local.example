# DO NOT fill this in manually.
# Run the merge script to pull production values from Vercel:
#
#   cd /mnt/c/FAZI/aifazi.net-main
#   bash scripts/merge-env.sh
#
# That creates .env.local with production Supabase, keys, and
# secrets merged from both Vercel projects. Only these lines
# are overridden for local Docker networking:
#
#   FRONTEND_URL=http://localhost:3000
#   NEXT_PUBLIC_API_URL=http://backend:8000
