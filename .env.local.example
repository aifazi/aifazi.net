# Token secrets — generate with: python -c "import secrets; print(secrets.token_hex(32))"
PASETO_SECRET=dev-paseto-secret-change-in-production-aaaaaaaaaaaa
JWT_SECRET=dev-jwt-secret-change-in-production-bbbbbbbbbbbb
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
INTERNAL_API_SECRET=dev-internal-secret-change-in-production-ccc
ADMIN_GATE_SECRET=dev-admin-gate-secret-change-in-production-d
CRON_SECRET=dev-cron-secret-change-in-production-eeeeeee

# App config
FRONTEND_URL=http://localhost:3000
ENV=development
BYPASS_INTERNAL_API=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Frontend ────────────────────────────────────────────
# The frontend talks to the backend container directly in dev
NEXT_PUBLIC_API_URL=http://backend:8000
NEXT_PUBLIC_SUPABASE_URL=http://supabase-rest:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImxvY2FsIiwicm9sZSI6ImFub24iLCJpYXQiOjE2MjIxNDI4MDAsImV4cCI6NDc3NzgxNjQwMH0.9T6MVZNE54IZ7RsRF29-TPPQq8YbmMnZp1ZgpIVN_yk
NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
